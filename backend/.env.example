PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
ENABLE_SHELL=1
# ADMIN_PASSWORD=至少10个字符（可选；推荐通过首次启动页面设置）
# DISABLE_BACKGROUND_JOBS=1
# SERVE_FRONTEND=1   # 生产环境设为 1 以托管前端 dist
# COMPOSE_BIN=docker # 'docker' -> 'docker compose'; 旧版可用 'docker-compose'

# MCP 端点(Hermes 定制 fork 新增):给外部 Agent(如 Hermes)用的工具通道,Streamable HTTP。
# 不配置 MCP_TOKEN 时 /mcp 端点关闭(503);配置后调用方必须带 Authorization: Bearer <token>。
# MCP_TOKEN=至少16位的随机串
# MCP_EXCLUDE_TOOLS=maintenance.clean,app.deploy,compose.exec,server.command
# MCP_WEB_SEARCH=1   # 放开 web.search 工具(默认关闭)
